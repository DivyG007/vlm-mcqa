/consolidation/report/*.out

# Large handoff/result archives belong under ignored data/results storage and
# must never be swept into Git from the repository root.
/handoff-*.zip
/*_results_*.tar.gz

# Python build and environment artifacts
__pycache__/
*.py[cod]
/.venv/
/.pytest_cache/
/.coverage
/htmlcov/
/build/
/dist/
*.egg-info/
.DS_Store

# This checkout already has its own Git history and remote.
/vlm-mcqa/

# Per-server settings for scripts/server (paths, PYTHON, HF_HOME)
/scripts/server/local.env

# project-memory managed ignores
/project-memory/.build/
/project-memory/raw/
/renders/
/rendered/
/extracted/

# Locally generated study-guide/publication output. Promote reviewed final
# artifacts explicitly into a deliberate tracked report or documentation path.
/output/
