# Temporary PDF extraction and rendering artifacts
/tmp/
/temp/
/.tmp/

# Private agent scratch and state
/.agents/
/.codex/

# Generated experiment artifacts
/data/generated/
/data/handoff/
/data/external/
/results/
/logs/
/cache/
/checkpoints/
/wandb/

# Disposable local publication-check output
/errors-*.json

# Disposable report build products and superseded local package
/consolidation/report.zip
